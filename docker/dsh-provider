#!/usr/bin/env node
'use strict';
// Root helper: configure (register or replace) a custom provider for an
// EXISTING user (Docker deployment).
//
// Usage: dsh-provider <username> <control-socket> '<provider-json>'
//                     (API key on stdin)
//
// Runs as root via sudo from the gateway (pinned in the dsh-gateway sudoers
// allowlist). It forwards {cmd:'set-provider'} to the entrypoint supervisor,
// which writes the user's settings.yaml (llm-pi-ai provider profile +
// agent-default-model) and stores the API key owner-only. A dormant tenant
// remains dormant; an already-running tenant is restarted so the change is
// applied immediately.
//
// The socket path is passed explicitly because sudo strips custom environment
// variables (env_reset); every component defaults to /run/dsh/control.sock.

const fs = require('fs');
const net = require('net');

const SOCKET = process.argv[3] || process.env.DSH_CONTROL_SOCKET || '/run/dsh/control.sock';

function fail(msg, code) {
  process.stderr.write(msg + '\n');
  process.exit(code);
}

const name = process.argv[2];
if (!name || !/^[A-Za-z0-9_-]{1,64}$/.test(name)) fail('invalid username', 2);
let provider;
try {
  provider = JSON.parse(process.argv[4] || '');
} catch (e) {
  fail('invalid provider json', 2);
}
if (!provider || typeof provider !== 'object' || Array.isArray(provider)) fail('provider is required', 2);
let key = '';
try { key = fs.readFileSync(0, 'utf8').replace(/\r?\n$/, ''); } catch (e) { fail('cannot read API key', 2); }
if (!key) fail('API key is required', 2);

const payload = JSON.stringify({ cmd: 'set-provider', name: name, provider: provider, key: key }) + '\n';
const sock = net.connect(SOCKET);
let buf = '';
const timer = setTimeout(() => { sock.destroy(); fail('control socket timeout', 1); }, 150000);
sock.setEncoding('utf8');
sock.on('connect', () => sock.write(payload));
sock.on('data', (c) => { buf += c; });
sock.on('end', () => {
  clearTimeout(timer);
  let reply;
  try { reply = JSON.parse(buf); } catch (e) { fail('invalid supervisor reply', 1); }
  process.stdout.write(JSON.stringify(reply) + '\n');
  process.exit(reply && reply.ok === true ? 0 : 1);
});
sock.on('error', (e) => { clearTimeout(timer); fail('cannot reach supervisor: ' + e.message, 1); });
