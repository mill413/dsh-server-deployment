#!/usr/bin/env node
'use strict';
// Root helper for self-service registration (Docker deployment).
//
// Usage: dsh-register <username> [control-socket] [provider-json]
//                    (password on stdin)
//        dsh-register --wake <username> [control-socket]
//        dsh-register --sleep <username> [control-socket] [reason] [revoke-sessions]
//        dsh-register --stats [control-socket]
//        dsh-register --key-status-all [control-socket]
//        dsh-register --du [control-socket]
//        dsh-register --plugin-list [control-socket]
//        dsh-register --plugin-cancel [control-socket]
//        dsh-register --plugin-add <name> <spec> [control-socket]
//        dsh-register --plugin-remove <name> [control-socket]
//
// Runs as root via sudo from the gateway (pinned in the dsh-gateway sudoers
// allowlist). Like the dsh-file-* helpers, it only forwards a validated
// request: it connects to the entrypoint supervisor's control socket and asks
// it to provision the user (OS account, port, firewall, users.json, optional
// custom-provider config), or to wake an existing user's lazy DSH process.
// The supervisor performs all real
// validation and provisioning, so this helper never needs to know the password
// beyond forwarding it once.
//
// The socket path is passed explicitly because sudo strips custom environment
// variables (env_reset); the gateway resolves DSH_CONTROL_SOCKET (defaulting
// to /run/dsh/control.sock) and hands it over as argv. The optional third
// argument is a JSON provider spec ({name,baseURL,model}) for the registration
// API; the browser form omits it.

const fs = require('fs');
const net = require('net');

const option = process.argv[2];
const mode = option === '--wake' ? 'wake'
  : (option === '--sleep' ? 'sleep'
    : (option === '--stats' ? 'stats'
      : (option === '--du' ? 'du'
        : (option === '--key-status-all' ? 'key-status-all'
          : (option === '--plugin-list' ? 'plugin-list'
            : (option === '--plugin-cancel' ? 'plugin-cancel'
              : (option === '--plugin-add' ? 'plugin-add'
                : (option === '--plugin-remove' ? 'plugin-remove' : 'add'))))))));
const helperMode = mode !== 'add';
const noNameMode = mode === 'stats' || mode === 'plugin-list' || mode === 'key-status-all' || mode === 'du' || mode === 'plugin-cancel';
const name = noNameMode ? null : (helperMode ? process.argv[3] : process.argv[2]);
const spec = mode === 'plugin-add' ? process.argv[4] : null;
const socketArg = noNameMode ? process.argv[3]
  : (mode === 'plugin-add' ? process.argv[5] : (helperMode ? process.argv[4] : process.argv[3]));
const SOCKET = socketArg
  || process.env.DSH_CONTROL_SOCKET || '/run/dsh/control.sock';
// Provisioning may initialize a profile, register shared plugins and refresh
// firewall rules before the supervisor can reply. Keep this longer than the
// former 10-second budget so a successful slow registration is not reported
// as a control-socket failure.
const CONTROL_TIMEOUT_MS = mode.startsWith('plugin-') ? 1800000 : 150000;

function fail(msg, code) {
  process.stderr.write(msg + '\n');
  process.exit(code);
}

function validPackageName(value) {
  return typeof value === 'string' && /^(?:@[A-Za-z0-9._-]+\/)?[A-Za-z0-9._-]+$/.test(value);
}

if (!noNameMode) {
  const valid = mode.startsWith('plugin-') ? validPackageName(name) : /^[A-Za-z0-9_-]{1,64}$/.test(name || '');
  if (!valid) fail(mode.startsWith('plugin-') ? 'invalid package name' : 'invalid username', 2);
}
if (mode === 'plugin-add'
    && (typeof spec !== 'string' || spec.length === 0 || spec.length > 512
      || spec.startsWith('-') || /[\r\n\0]/.test(spec))) fail('invalid plugin spec', 2);
let password = '';
if (!helperMode) {
  try {
    password = fs.readFileSync(0, 'utf8').replace(/\r?\n$/, '');
  } catch (e) {
    fail('cannot read password', 2);
  }
  if (password.length < 8) fail('password must contain at least 8 characters', 2);
}

let payload;
if (mode === 'stats') payload = { cmd: 'stats' };
else if (mode === 'du') payload = { cmd: 'du' };
else if (mode === 'plugin-cancel') payload = { cmd: 'plugin-cancel' };
else if (mode === 'key-status-all') payload = { cmd: 'key-status-all' };
else if (mode === 'plugin-list') payload = { cmd: 'shared-plugin-list' };
else if (mode === 'plugin-add') payload = { cmd: 'shared-plugin-add', name: name, spec: spec };
else if (mode === 'plugin-remove') payload = { cmd: 'shared-plugin-remove', name: name };
else if (mode === 'wake') payload = { cmd: 'wake', name: name };
else if (mode === 'sleep') {
  payload = {
    cmd: 'sleep',
    name: name,
    reason: String(process.argv[5] || 'logout').slice(0, 64),
    // Keep the historical default for callers that omit the flag. Automatic
    // browser-presence recycling passes 0 so stopping an idle tenant does not
    // also invalidate an otherwise valid login cookie.
    revokeSessions: String(process.argv[6] || '1') !== '0',
  };
} else payload = { cmd: 'add', name: name, password: password };
const providerRaw = helperMode ? null : process.argv[4];
if (providerRaw) {
  try {
    payload.provider = JSON.parse(providerRaw);
  } catch (e) {
    fail('invalid provider json', 2);
  }
}
const sock = net.connect(SOCKET);
let buf = '';
let finalReply = null;
const timer = setTimeout(() => { sock.destroy(); fail('control socket timeout', 1); }, CONTROL_TIMEOUT_MS);
sock.setEncoding('utf8');
sock.on('connect', () => sock.write(JSON.stringify(payload) + '\n'));
sock.on('data', (c) => {
  buf += c;
  while (true) {
    const newline = buf.indexOf('\n');
    if (newline < 0) break;
    const line = buf.slice(0, newline);
    buf = buf.slice(newline + 1);
    let message;
    try { message = JSON.parse(line); } catch (e) { fail('invalid supervisor reply', 1); }
    if (message && Object.prototype.hasOwnProperty.call(message, 'progress')) {
      process.stderr.write(String(message.progress));
    } else {
      finalReply = message;
    }
  }
});
sock.on('end', () => {
  clearTimeout(timer);
  if (!finalReply) fail('invalid supervisor reply', 1);
  process.stdout.write(JSON.stringify(finalReply) + '\n');
  process.exit(finalReply.ok === true ? 0 : 1);
});
sock.on('error', (e) => { clearTimeout(timer); fail('cannot reach supervisor: ' + e.message, 1); });
