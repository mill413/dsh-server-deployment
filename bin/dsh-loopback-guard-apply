#!/usr/bin/env bash
# dsh-loopback-guard-apply -- rebuild the tenant loopback firewall from
# users.json. Thin wrapper so the systemd unit stays a plain ExecStart line
# (systemd does not run $() command substitution).
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
USERS_FILE="${USERS_FILE:-/opt/deepseek-harness/gateway/users.json}"
node_bin="$(command -v node)"
[ -n "$node_bin" ] || node_bin="/usr/bin/node"
# Gateway port resolution order:
#   1. GW_PORT env (explicit override - always wins)
#   2. state-port.json written by the gateway at startup (handles PORT
#      overrides without duplicating the value here)
#   3. default 3100
# A guard that rejects the WRONG port protects nothing (issue #5): tenants
# could then reach the real gateway loopback and forge X-Forwarded-For
# against the login rate limiter.
if [ -z "${GW_PORT:-}" ]; then
  port_file="$(dirname "$USERS_FILE")/state-port.json"
  if [ -f "$port_file" ]; then
    GW_PORT="$("$node_bin" -e 'try{process.stdout.write(String(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).port||""))}catch(e){}' "$port_file")" || GW_PORT=""
  fi
fi
export GW_PORT="${GW_PORT:-3100}"
specs="$("$node_bin" -e 'const u=JSON.parse(require("fs").readFileSync(process.env.USERS_FILE,"utf8")).users;process.stdout.write(Object.values(u).filter(x=>x&&x.osUser&&x.port).map(x=>x.osUser+":"+x.port).join(" "))' )" || {
  echo "cannot read $USERS_FILE" >&2
  exit 1
}
[ -n "$specs" ] || {
  echo "no users in $USERS_FILE, removing guard rules"
  exec "$here/dsh-loopback-guard" --remove
}
# shellcheck disable=SC2086
exec "$here/dsh-loopback-guard" --apply $specs
