#!/usr/bin/env bash
# dsh-file-mkdir <home> <dir> <name> -- create one visible directory inside
# the tenant workspace. Runs the filesystem operation as the tenant OS user.
# exit: 2 invalid name, 3 out of scope, 4 parent missing, 6 already exists.
set -euo pipefail
home="${1:-}"
dir="${2:-}"
name="${3:-}"
[ -n "$home" ] && [ -n "$dir" ] && [ -n "$name" ] || exit 2
here="$(cd "$(dirname "$0")" && pwd)"
node_bin="$here/../runtime/bin/node"
[ -x "$node_bin" ] || node_bin="$(command -v node || true)"
[ -n "$node_bin" ] || exit 4
osu="dsh-$(printf '%s' "$(basename "$home")" | tr '[:upper:]' '[:lower:]')"
case "$osu" in
  dsh-?*) ;;
  *) exit 3 ;;
esac
case "$osu" in
  *[!a-z0-9_-]*) exit 3 ;;
esac
exec runuser -u "$osu" -- "$node_bin" "$here/dsh-file-mkdir.js" "$home" "$dir" "$name"
