#!/usr/bin/env bash
# dsh-file-delete <home> <path> -- delete one visible file/symlink or empty
# directory inside the user's workspace.
# exit: 2 usage, 3 out of scope, 4 missing/unsupported, 5 hidden, 6 non-empty.
#
# Root only validates the target OS account. The deletion itself runs as the
# tenant account, so a symlink race cannot cross the OS-user security boundary.
set -euo pipefail
home="${1:-}"
target="${2:-}"
[ -n "$home" ] && [ -n "$target" ] || exit 2
here="$(cd "$(dirname "$0")" && pwd)"
node_bin="$here/../runtime/bin/node"
[ -x "$node_bin" ] || node_bin="$(command -v node || true)"
[ -n "$node_bin" ] || exit 4
osu="dsh-$(printf '%s' "$(basename "$home")" | tr '[:upper:]' '[:lower:]')"
case "$osu" in
  dsh-?*) ;;
  *) exit 3 ;;
esac
case "$osu" in
  *[!a-z0-9_-]*) exit 3 ;;
esac
exec runuser -u "$osu" -- "$node_bin" "$here/dsh-file-delete.js" "$home" "$target"
